{
  "description": "QA Kit guardrails: block secrets in written files, and stop assertion changes in test files from slipping through (ask locally, deny in CI).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-secrets.mjs"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-assertions.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
