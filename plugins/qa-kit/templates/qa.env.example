# QA Kit variables. Copy into your local .env (gitignored) next to the app's own variables.
# Named qa.env.example so it never clashes with the app's .env.example or a `.env*` gitignore rule.

# App under test. Set BASE_URL to test a staging URL; leave it unset to test this checkout
# (Playwright starts it with app.devCommand / app.startCommand from .qa/config.json).
# Never point BASE_URL at production.
# BASE_URL=https://staging.example.com

# Seeded test account (staging, or your local database). Never a real customer's login.
QA_USER_EMAIL=
QA_USER_PASSWORD=

# One pair per role when .qa/config.json has "roles", e.g. { "admin": { "env": "QA_ADMIN" }, "staff": { "env": "QA_STAFF" } }.
# The QA_USER pair above is then unused.
# QA_ADMIN_EMAIL=
# QA_ADMIN_PASSWORD=
# QA_STAFF_EMAIL=
# QA_STAFF_PASSWORD=

# TestRail (dedicated API user; API key from TestRail > My Settings > API Keys)
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_USER=
TESTRAIL_API_KEY=

# Optional: Slack incoming webhook for the digest
SLACK_WEBHOOK_URL=
